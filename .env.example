# Jarvis environment (copy to .env or set in your shell)
# Nothing here is required; every value has a portable default.

# The Hermes CLI. Leave unset if it is in the standard install location.
# HERMES_BIN=C:\Users\you\AppData\Local\hermes\hermes-agent\.hermes\bin\hermes.exe

# Optional: a self-hosted OpenAI-compatible provider this machine uses.
# JARVIS_PROVIDER_HOST=127.0.0.1
# JARVIS_PROVIDER_PORT=11434
# JARVIS_PROBE_HOST=127.0.0.1
# JARVIS_NO_PROXY_EXTRA=127.0.0.1

# Optional: FreeLLMAPI local router (client key created in the app)
# FREELMAPI_KEY=sk-cp-...
# JARVIS_DIRECT_MODEL=auto

# Optional: second-model answer review
# JARVIS_VERIFY=cross
